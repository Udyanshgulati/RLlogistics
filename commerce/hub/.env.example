# Copy to .env (never committed). Real environment variables override this file.
APP_ENV=development              # production | staging | development
APP_URL=http://localhost:8080    # used in set-up links
DISPLAY_TZ=Asia/Kolkata
DB_DSN=mysql:host=localhost;dbname=commerce_hub;charset=utf8mb4
DB_USER=hub
DB_PASSWORD=
FORCE_SECURE_COOKIES=0           # 1 behind a TLS-terminating proxy
MARKETS_CONFIG=                  # path to markets.json; defaults to config/markets.example.json
DEMO_PASSWORD=                   # only for `bin/hub demo` on non-production

# Per storefront (CODE = store code upper-cased, hyphens as underscores: MILAN_ICONS, SIGNIFICANT_SPORTS, SCHERMO)
# STORE_SCHERMO_WC_KEY=           WooCommerce REST key (read/write on products and orders only)
# STORE_SCHERMO_WC_SECRET=
# STORE_SCHERMO_HUB_SECRET=       shared secret for the connector's signed calls (checkout reservations)
# STORE_SCHERMO_WEBHOOK_SECRET=   secret set on the WooCommerce "Order updated" webhook
